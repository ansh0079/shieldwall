{
  "manifest_version": 3,
  "name": "BeforeYouBuy - Seller Check",
  "version": "0.3.0",
  "description": "Real-time risk assessment, seller reviews and scam warnings for online stores.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://rdap.org/*",
    "https://rdap.verisign.com/*",
    "https://web.archive.org/*",
    "https://safebrowsing.googleapis.com/*",
    "https://api.trustpilot.com/*",
    "https://api.company-information.service.gov.uk/*",
    "https://trustcheck.soloinvestor-ai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/merchant-rating.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.co.jp/*",
        "*://*.google.it/*",
        "*://*.google.es/*",
        "*://*.google.nl/*",
        "*://*.bing.com/*",
        "*://duckduckgo.com/*",
        "*://*.yahoo.com/*",
        "*://*.ecosia.org/*",
        "*://*.startpage.com/*",
        "*://search.brave.com/*",
        "*://*.yandex.com/*",
        "*://*.yandex.ru/*",
        "*://*.baidu.com/*",
        "*://*.qwant.com/*"
      ],
      "js": [
        "lib/search-seller.js",
        "search_hover.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "BeforeYouBuy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "trustcheck@shieldwall.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  }
}
