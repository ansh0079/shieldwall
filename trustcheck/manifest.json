{
  "manifest_version": 3,
  "name": "BeforeYouBuy - Seller Check",
  "version": "0.3.0",
  "description": "Real-time risk assessment, seller reviews and scam warnings for online stores.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://rdap.org/*",
    "https://rdap.verisign.com/*",
    "https://web.archive.org/*",
    "https://safebrowsing.googleapis.com/*",
    "https://api.trustpilot.com/*",
    "https://api.company-information.service.gov.uk/*",
    "https://trustcheck.soloinvestor-ai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/merchant-rating.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.co.jp/*",
        "*://*.google.it/*",
        "*://*.google.es/*",
        "*://*.google.nl/*",
        "*://*.bing.com/*",
        "*://duckduckgo.com/*",
        "*://*.yahoo.com/*",
        "*://*.ecosia.org/*",
        "*://*.startpage.com/*",
        "*://search.brave.com/*",
        "*://*.yandex.com/*",
        "*://*.yandex.ru/*",
        "*://*.baidu.com/*",
        "*://*.qwant.com/*"
      ],
      "js": [
        "lib/search-seller.js",
        "search_hover.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "BeforeYouBuy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
