{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "4.7.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "notifications",
    "contextMenus",
    "alarms",
    "scripting",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils.js",
        "phish_score.js",
        "content.js",
        "cookie_reject.js",
        "zapper.js",
        "shield.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "quiet_rules",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "quiet_easylist",
        "enabled": true,
        "path": "easylist_rules.json"
      },
      {
        "id": "quiet_privacy",
        "enabled": true,
        "path": "privacy_rules.json"
      },
      {
        "id": "quiet_headers",
        "enabled": true,
        "path": "headers_rules.json"
      },
      {
        "id": "quiet_opt_adguard-base_p1",
        "enabled": true,
        "path": "rules_opt_adguard-base_p1.json"
      },
      {
        "id": "quiet_opt_adguard-tracking_p1",
        "enabled": false,
        "path": "rules_opt_adguard-tracking_p1.json"
      },
      {
        "id": "quiet_opt_adguard-tracking_p2",
        "enabled": false,
        "path": "rules_opt_adguard-tracking_p2.json"
      },
      {
        "id": "quiet_opt_adguard-tracking_p3",
        "enabled": false,
        "path": "rules_opt_adguard-tracking_p3.json"
      },
      {
        "id": "quiet_opt_adguard-tracking_p4",
        "enabled": false,
        "path": "rules_opt_adguard-tracking_p4.json"
      },
      {
        "id": "quiet_opt_adguard-tracking_p5",
        "enabled": false,
        "path": "rules_opt_adguard-tracking_p5.json"
      },
      {
        "id": "quiet_opt_peterlowe_p1",
        "enabled": true,
        "path": "rules_opt_peterlowe_p1.json"
      },
      {
        "id": "quiet_opt_ublock-filters_p1",
        "enabled": true,
        "path": "rules_opt_ublock-filters_p1.json"
      },
      {
        "id": "quiet_opt_ublock-privacy_p1",
        "enabled": true,
        "path": "rules_opt_ublock-privacy_p1.json"
      },
      {
        "id": "quiet_opt_ubo-quick-fixes_p1",
        "enabled": true,
        "path": "rules_opt_ubo-quick-fixes_p1.json"
      },
      {
        "id": "quiet_opt_fanboy-annoyance_p1",
        "enabled": false,
        "path": "rules_opt_fanboy-annoyance_p1.json"
      },
      {
        "id": "quiet_opt_easylist-cookie_p1",
        "enabled": false,
        "path": "rules_opt_easylist-cookie_p1.json"
      },
      {
        "id": "quiet_opt_fanboy-social_p1",
        "enabled": false,
        "path": "rules_opt_fanboy-social_p1.json"
      },
      {
        "id": "quiet_opt_easylist-germany_p1",
        "enabled": false,
        "path": "rules_opt_easylist-germany_p1.json"
      }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "start-zapper": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "__MSG_zapCommandDescription__"
    }
  },
  "action": {
    "default_title": "__MSG_actionDefaultTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}